# ══════════════════════════════════════════════════════════════════════════════
#  Discord Server Cloner v9.0 ULTRA (2026) — Production Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
#  Этот файл автоматически загружается через python-dotenv.
#  Изменения вступают в силу ТОЛЬКО после перезапуска сервера.
#
#  Формат: KEY=value
#  Булевы значения: true, false, 1, 0, yes, no, on, off
#  Числовые значения: целые или дробные числа
#  Списки: значение1,значение2,значение3
#
#  ВАЖНО: Значения со спецсимволами (; ? & =) заключайте в кавычки!
#  ВАЖНО: Не добавляйте пробелы вокруг знака =
#
# ══════════════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────────────────
#  1. ЯДРО И СЕТЬ
# ──────────────────────────────────────────────────────────────────────────────

DISCORD_API=https://discord.com/api/v10
CDN=https://cdn.discordapp.com
MEDIA=https://media.discordapp.net
GATEWAY="wss://gateway.discord.gg/?v=10&encoding=json"

HOST=127.0.0.1
PORT=5500
DEBUG=false


# ──────────────────────────────────────────────────────────────────────────────
#  2. БЕЗОПАСНОСТЬ И СЕССИИ
# ──────────────────────────────────────────────────────────────────────────────
#  Генерация SECRET_KEY:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ──────────────────────────────────────────────────────────────────────────────

SECRET_KEY=ultra-secure-discord-cloner-2026-change-this-key-now
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
SESSION_LIFETIME=3600

SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"


# ──────────────────────────────────────────────────────────────────────────────
#  3. API BYPASS & АНТИ-ДЕТЕКТ
# ──────────────────────────────────────────────────────────────────────────────
#  ИСПРАВЛЕНО: TLS_SPOOFING_ENABLED=false
#  curl_cffi вызывает "Recv failure: Connection was reset" на Windows.
#  brain.py использует стандартный requests (стабильно и без ошибок).
# ──────────────────────────────────────────────────────────────────────────────

STEALTH_MODE=true
TLS_SPOOFING_ENABLED=false
TLS_IMPERSONATE_PROFILE=chrome120
ROTATE_USER_AGENTS=true
MINIFY_PAYLOADS=true
RANDOMIZE_CREATION_ORDER=false
GENERATE_CONTEXT_PROPERTIES=true
GENERATE_SUPER_PROPERTIES=true
RATELIMIT_PRECISION=millisecond


# ──────────────────────────────────────────────────────────────────────────────
#  4. RATE LIMIT DEFENSE (Защита от 429)
# ──────────────────────────────────────────────────────────────────────────────

BRAIN_MAX_RETRIES=10
BRAIN_TIMEOUT_DEFAULT=30
BRAIN_TIMEOUT_UPLOAD=90
BRAIN_TIMEOUT_DOWNLOAD=60

CIRCUIT_BREAKER_THRESHOLD=2
CIRCUIT_BREAKER_PENALTY=45.0

PREEMPTIVE_THROTTLE_ENABLED=true
PREEMPTIVE_THROTTLE_THRESHOLD=1

BACKOFF_BASE=2.0
BACKOFF_MAX=60.0
BACKOFF_JITTER=0.5

BRAIN_JITTER_MIN=0.1
BRAIN_JITTER_MAX=0.5


# ──────────────────────────────────────────────────────────────────────────────
#  5. SMART DELAY SYSTEM (Задержки 2-5 секунд)
# ──────────────────────────────────────────────────────────────────────────────
#  НЕ МЕНЯЙТЕ на < 2.0 при использовании 1 токена!
# ──────────────────────────────────────────────────────────────────────────────

DELAY_ROLE_MIN=2.0
DELAY_ROLE_MAX=5.0

DELAY_CHANNEL_MIN=2.0
DELAY_CHANNEL_MAX=5.0

DELAY_EMOJI_MIN=2.5
DELAY_EMOJI_MAX=5.0

DELAY_STICKER_MIN=3.0
DELAY_STICKER_MAX=6.0

DELAY_WEBHOOK_MIN=2.0
DELAY_WEBHOOK_MAX=4.0

DELAY_DELETE_MIN=1.0
DELAY_DELETE_MAX=2.5

DELAY_MEMBER_ROLE_MIN=1.5
DELAY_MEMBER_ROLE_MAX=3.5

DELAY_AUTOMOD_MIN=2.0
DELAY_AUTOMOD_MAX=4.0

DELAY_INVITE_MIN=1.5
DELAY_INVITE_MAX=3.0

DELAY_SETTINGS_MIN=1.0
DELAY_SETTINGS_MAX=2.0

DELAY_RESYNC_MIN=0.5
DELAY_RESYNC_MAX=1.5


# ──────────────────────────────────────────────────────────────────────────────
#  6. BATCH PROCESSING (Пакетная обработка)
# ──────────────────────────────────────────────────────────────────────────────

ROLE_BATCH_SIZE=3
ROLE_BATCH_PAUSE=12.0

CHANNEL_BATCH_SIZE=8
CHANNEL_BATCH_PAUSE=10.0

EMOJI_BATCH_SIZE=5
EMOJI_BATCH_PAUSE=8.0

STICKER_BATCH_SIZE=3
STICKER_BATCH_PAUSE=10.0

MEMBER_BATCH_SIZE=10
MEMBER_BATCH_PAUSE=5.0


# ──────────────────────────────────────────────────────────────────────────────
#  7. CHANNEL CLONING ENGINE
# ──────────────────────────────────────────────────────────────────────────────

CLONE_FORUM_TAGS=true
MAX_FORUM_TAGS=20
MAX_FORUM_TAG_NAME_LENGTH=20

CLONE_STAGE_TOPICS=true
CLONE_NSFW=true
CLONE_SLOWMODE=true
MAX_SLOWMODE=21600

CLONE_CATEGORY_POSITIONS=true

MAX_BITRATE_FREE=96000
MAX_BITRATE_BOOST_1=128000
MAX_BITRATE_BOOST_2=256000
MAX_BITRATE_BOOST_3=384000


# ──────────────────────────────────────────────────────────────────────────────
#  8. ROLE CLONING ENGINE
# ──────────────────────────────────────────────────────────────────────────────

CLONE_ROLE_ICONS=true
CLONE_ROLE_EMOJIS=true
SYNC_ROLE_HIERARCHY=true
MAX_ROLE_NAME_LENGTH=100
SKIP_MANAGED_ROLES=true


# ──────────────────────────────────────────────────────────────────────────────
#  9. СТРАТЕГИЯ КЛОНИРОВАНИЯ
# ──────────────────────────────────────────────────────────────────────────────

CLONE_PURGE_TARGET=true
CLONE_ROLES=true
CLONE_CHANNELS=true
CLONE_EMOJIS=true
CLONE_STICKERS=true
CLONE_SETTINGS=true
CLONE_AUTOMOD=true
CLONE_WEBHOOKS=true
CLONE_INVITES=true
CLONE_MEMBER_ROLES=true
CLONE_RESYNC_PERMISSIONS=true
CLONE_EVENTS=true
CLONE_SOUNDBOARD=true
CLONE_ONBOARDING=true

CLONE_SKIP_BOTS=true
CLONE_ONLY_NON_ADMIN_ROLES=true
CLONE_SKIP_MANAGED_ROLES=true

CLONE_RETRY_ON_ERROR=true
CLONE_STOP_ON_CRITICAL=true
CLONE_SKIP_ON_LIMIT=true


# ──────────────────────────────────────────────────────────────────────────────
#  10. ЛИМИТЫ DISCORD API
# ──────────────────────────────────────────────────────────────────────────────

MAX_CHANNELS=500
MAX_ROLES=250
MAX_EMOJIS_FREE=50
MAX_EMOJIS_BOOST=250
MAX_STICKERS_FREE=5
MAX_STICKERS_BOOST=60
MAX_WEBHOOKS_PER_CHANNEL=15
MAX_INVITES_PER_GUILD=1000
MAX_AUTOMOD_RULES=100

MAX_ICON_SIZE=262144
MAX_BANNER_SIZE=10485760
MAX_SPLASH_SIZE=10485760
MAX_EMOJI_SIZE=262144
MAX_STICKER_SIZE=524288
MAX_ROLE_ICON_SIZE=262144


# ──────────────────────────────────────────────────────────────────────────────
#  11. ПРОКСИ И РОТАЦИЯ ТОКЕНОВ
# ──────────────────────────────────────────────────────────────────────────────

TOKEN_ROTATION_STRATEGY=least_used
PROXY_ROTATION_ENABLED=true
PROXY_ROTATION_MODE=per_request
PROXY_TIMEOUT=10
PROXY_MAX_FAILURES=3


# ──────────────────────────────────────────────────────────────────────────────
#  12. ЛОГИРОВАНИЕ
# ──────────────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"
LOG_DATE_FORMAT="%Y-%m-%d %H:%M:%S"
LOG_FILE=logs/cloner_ultra.log
LOG_MAX_BYTES=15728640
LOG_BACKUP_COUNT=5
LOG_ENABLE_JSON=false

ENABLE_PERFORMANCE_METRICS=true
METRICS_INTERVAL=60


# ──────────────────────────────────────────────────────────────────────────────
#  13. УПРАВЛЕНИЕ ЗАДАЧАМИ
# ──────────────────────────────────────────────────────────────────────────────

TASK_TTL=3600
TASK_CLEANUP_INTERVAL=300


# ──────────────────────────────────────────────────────────────────────────────
#  14. ВАЛИДАЦИЯ
# ──────────────────────────────────────────────────────────────────────────────

CONFIG_VALIDATE=true